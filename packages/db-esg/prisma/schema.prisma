generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model esg_articles {
  id               Int       @id @default(autoincrement())
  title            String?
  published        DateTime? @db.Date
  summary          String?
  link             String?   @unique(map: "esg_articles_link_key")
  source           String?
  matched_keywords String?
  save_time        DateTime? @default(now()) @db.Timestamp(6)
}

model events {
  id              Int       @id(map: "esg_events_pkey") @default(autoincrement())
  event_name      String?
  event_id        String?   @unique(map: "esg_events_event_id_key")
  event_url       String?
  start_date      DateTime? @db.Date
  end_date        DateTime? @db.Date
  start_time      DateTime? @db.Time(6)
  end_time        DateTime? @db.Time(6)
  timezone        String?
  timezone_iana   String?   @db.VarChar(64)
  image_url       String?
  ticket_price    String?
  tickets_url     String?
  venue_name      String?
  venue_address   String?
  country_code    String?   @db.VarChar(2)
  city            String?   @db.VarChar(120)
  attendance_mode String?   @db.VarChar(16)
  organizer_name  String?
  organizer_url   String?
  summary         String?
  tags            String?
  source          String?
  month           String?
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  event_data      Json?
  detail_scrape_status String?
  original_language String?
  translation_status String?
  translation_model String?
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  @@index([start_date, end_date], map: "idx_events_start_end_date")
  @@index([end_date], map: "idx_events_end_date")
  @@index([source, start_date, end_date], map: "idx_events_source_date")
  @@index([country_code, city, start_date, end_date], map: "idx_events_country_city_date")
}

model file_uploads {
  id                Int       @id @default(autoincrement())
  task_id           String    @unique @db.VarChar(36)
  original_filename String    @db.VarChar(256)
  stored_filename   String    @db.VarChar(256)
  output_filename   String?   @db.VarChar(256)
  file_data         Bytes?
  status            String?   @db.VarChar(20)
  error_message     String?
  user_id           Int?
  created_at        DateTime? @db.Timestamp(6)
  updated_at        DateTime? @db.Timestamp(6)
  progress          Int       @default(0)
  rows_total        Int       @default(0)
  rows_done         Int       @default(0)
  warning_count     Int       @default(0)
  warnings_json     Json      @default("[]")
  users             users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model likes {
  id           Int       @id @default(autoincrement())
  user_id      Int
  content_type String    @db.VarChar(20)
  content_id   Int
  created_at   DateTime? @db.Timestamp(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_likes_user_id")

  @@unique([user_id, content_type, content_id], map: "unique_like")
  @@index([content_type], map: "ix_likes_content_type")
  @@index([user_id], map: "ix_likes_user_id")
}

model pdf_translation_v2_jobs {
  id               String                     @id @db.Uuid
  user_id          Int
  filename         String
  target_lang      String                     @default("English") @db.VarChar(40)
  status           String                     @default("queued") @db.VarChar(20)
  stage            String                     @default("queued") @db.VarChar(40)
  message          String?
  progress         Int                        @default(0)
  total_pages      Int                        @default(0)
  current_page     Int                        @default(0)
  document_context Json?
  metrics          Json                       @default("{}")
  input_pdf        Bytes
  output_pdf       Bytes?
  created_at       DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  completed_at     DateTime?                  @db.Timestamptz(6)
  user             users                      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pdf_translation_v2_jobs_user_id_fkey")
  pages            pdf_translation_v2_pages[]
  usage_events     pdf_translation_v2_usage_events[]

  @@index([user_id, created_at(sort: Desc)], map: "idx_pdf_translation_v2_jobs_user_created")
  @@index([status, created_at], map: "idx_pdf_translation_v2_jobs_status_created")
}

model pdf_translation_v2_pages {
  id                   Int                     @id @default(autoincrement())
  job_id               String                  @db.Uuid
  page_number          Int
  status               String                  @default("pending") @db.VarChar(20)
  source_layout        Json?
  translated_layout    Json?
  source_text          String?
  translated_text      String?
  extraction_model     String?                 @db.VarChar(80)
  translation_model    String?                 @db.VarChar(80)
  extraction_attempts  Int                     @default(0)
  translation_attempts Int                     @default(0)
  input_tokens         Int                     @default(0)
  output_tokens        Int                     @default(0)
  validation           Json?
  warnings             Json                    @default("[]")
  error_message        String?
  created_at           DateTime                @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  job                  pdf_translation_v2_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pdf_translation_v2_pages_job_id_fkey")

  @@unique([job_id, page_number], map: "pdf_translation_v2_pages_job_page_key")
  @@index([job_id, status, page_number], map: "idx_pdf_translation_v2_pages_job_status")
}

model pdf_translation_v2_usage_events {
  id          BigInt                 @id @default(autoincrement()) @db.BigInt
  job_id      String                 @db.Uuid
  page_number Int?
  operation   String                 @db.VarChar(40)
  response_id String
  model       String                 @db.VarChar(80)
  input_tokens Int                   @default(0)
  output_tokens Int                  @default(0)
  created_at  DateTime               @default(now()) @db.Timestamptz(6)
  job         pdf_translation_v2_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pdf_translation_v2_usage_events_job_id_fkey")

  @@unique([job_id, operation, response_id], map: "pdf_translation_v2_usage_event_key")
  @@index([created_at], map: "idx_pdf_translation_v2_usage_created")
  @@index([job_id, page_number], map: "idx_pdf_translation_v2_usage_job_page")
}

model publications {
  id        Int       @id(map: "esg_publications_pkey") @default(autoincrement())
  title     String?
  published DateTime? @db.Timestamp(6)
  summary   String?
  link      String?   @unique(map: "esg_publications_link_key")
  source    String?
  image_url String?
  save_time DateTime? @default(now()) @db.Timestamp(6)
}

model user_preferences {
  id                Int      @id @default(autoincrement())
  user_id           Int?
  preferred_sources String[] @default([])
  preferred_topics  String[] @default([])
  users             users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                             Int                           @id @default(autoincrement())
  username                                       String                        @unique(map: "ix_users_username") @db.VarChar(255)
  email                                          String?                       @unique(map: "ix_users_email") @db.VarChar(255)
  password                                       String?                       @db.VarChar(255)
  password_hash                                  String                        @db.VarChar(255)
  first_name                                     String?                       @db.VarChar(64)
  last_name                                      String?                       @db.VarChar(64)
  is_admin                                       Boolean?                      @default(false)
  created_at                                     DateTime?                     @default(now()) @db.Timestamp(6)
  last_login                                     DateTime?                     @db.Timestamp(6)
  preferred_categories                           String?                       @db.VarChar(256)
  email_notifications                            Boolean?                      @default(true)
  is_active_db                                   Boolean                       @default(true)
  team                                           String?                       @db.VarChar(100)
  action_items                                   action_items[]
  alert_history                                  alert_history[]
  alert_preferences                              alert_preferences[]
  article_ai_sessions                            article_ai_sessions[]
  article_conversations                          article_conversations[]
  decisions                                      decisions[]
  email_queue                                    email_queue[]
  esg_event_digest_recipients_created            esg_event_digest_recipients[] @relation("esg_event_digest_recipients_created_by")
  esg_event_digest_recipients_updated            esg_event_digest_recipients[] @relation("esg_event_digest_recipients_updated_by")
  esg_driver_jobs                                esg_driver_jobs[]
  file_uploads                                   file_uploads[]
  likes                                          likes[]
  meeting_participants                           meeting_participants[]
  meetings                                       meetings[]
  pdf_translation_v2_jobs                        pdf_translation_v2_jobs[]
  questions_questions_asked_by_user_idTousers    questions[]                   @relation("questions_asked_by_user_idTousers")
  questions_questions_resolved_by_user_idTousers questions[]                   @relation("questions_resolved_by_user_idTousers")
  risks                                          risks[]
  speaker_mappings                               speaker_mappings[]
  transcript_segments                            transcript_segments[]
  user_preferences                               user_preferences[]
  user_activity                                  user_activity[]
  background_jobs                                background_jobs[]
  esg_driver_catalog_versions                    esg_driver_catalog_versions[]
  esg_driver_catalog_activations                 esg_driver_catalog_activations[]
  article_ai_preferences                         article_ai_preferences[]
  article_ai_profiles                            article_ai_profiles[]
  article_ai_runs                                article_ai_runs[]
  article_ai_selections                          article_ai_selections[]
  article_ai_feedback                            article_ai_feedback[]
  article_ai_budgets                             article_ai_budgets[]
  article_ai_user_selections                     article_ai_user_selections[]
  article_ai_domain_feedback                     article_ai_domain_feedback[]

  @@index([team], map: "ix_users_team")
}

model alert_preferences {
  id                      Int                  @id @default(autoincrement())
  user_id                 Int
  domain                  String               @db.VarChar(10)
  weekly_digest           Boolean?             @default(true)
  daily_digest            Boolean?             @default(false)
  immediate_alerts        Boolean?             @default(false)
  alert_articles          Boolean?             @default(true)
  alert_events            Boolean?             @default(true)
  alert_publications      Boolean?             @default(true)
  sources                 String[]             @default([])
  keywords                String[]             @default([])
  team_likes_only         Boolean?             @default(true)
  email_enabled           Boolean?             @default(true)
  email_address           String?              @db.VarChar(255)
  digest_day              String?              @default("Monday") @db.VarChar(10)
  digest_hour             Int?                 @default(9)
  timezone                String?              @default("Asia/Dubai") @db.VarChar(50)
  created_at              DateTime?            @default(now()) @db.Timestamp(6)
  updated_at              DateTime?            @default(now()) @db.Timestamp(6)
  alert_name              String?              @default("My Alert") @db.VarChar(255)
  alert_type              String?              @default("weekly_digest") @db.VarChar(50)
  is_active               Boolean?             @default(true)
  immediate_sources       String[]             @default([]) @db.VarChar(50)
  immediate_keywords      String[]             @default([]) @db.VarChar(100)
  immediate_content_types String[]             @default(["articles"]) @db.VarChar(50)
  last_sent_at            DateTime?            @db.Timestamp(6)
  next_send_at            DateTime?            @db.Timestamp(6)
  domains                 String[]             @default([]) @db.VarChar(20)
  alert_content_sent      alert_content_sent[]
  users                   users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([alert_type], map: "idx_alert_preferences_alert_type")
  @@index([is_active], map: "idx_alert_preferences_is_active")
  @@index([next_send_at], map: "idx_alert_preferences_next_send_at")
  @@index([user_id], map: "idx_alert_prefs_user")
}

model alert_history {
  id               Int          @id @default(autoincrement())
  user_id          Int?
  domain           String       @db.VarChar(10)
  alert_type       String       @db.VarChar(20)
  content_type     String?      @db.VarChar(20)
  content_ids      Int[]        @default([])
  email_to         String       @db.VarChar(255)
  email_subject    String?
  email_status     String?      @default("pending") @db.VarChar(20)
  total_items      Int?         @default(0)
  opened_at        DateTime?    @db.Timestamp(6)
  clicked_at       DateTime?    @db.Timestamp(6)
  error_message    String?
  retry_count      Int?         @default(0)
  sent_at          DateTime?    @db.Timestamp(6)
  created_at       DateTime?    @default(now()) @db.Timestamp(6)
  template_version String?      @db.VarChar(10)
  job_id           String?      @db.VarChar(100)
  delivery_key     String?      @unique(map: "alert_history_delivery_key_key") @db.VarChar(180)
  users            users?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  email_queue      email_queue?

  @@index([domain], map: "idx_alert_history_domain")
  @@index([sent_at(sort: Desc)], map: "idx_alert_history_sent")
  @@index([email_status], map: "idx_alert_history_status")
  @@index([alert_type], map: "idx_alert_history_type")
  @@index([user_id], map: "idx_alert_history_user")
}

model email_queue {
  id                  Int            @id @default(autoincrement())
  user_id             Int?
  email_to            String         @db.VarChar(255)
  email_subject       String
  email_body          String
  email_html          String?
  priority            Int?           @default(5)
  scheduled_for       DateTime       @db.Timestamp(6)
  status              String?        @default("queued") @db.VarChar(20)
  attempts            Int?           @default(0)
  max_attempts        Int?           @default(3)
  last_error          String?
  last_attempt_at     DateTime?      @db.Timestamp(6)
  sent_at             DateTime?      @db.Timestamp(6)
  processed_by        String?        @db.VarChar(100)
  created_at          DateTime?      @default(now()) @db.Timestamp(6)
  updated_at          DateTime?      @default(now()) @db.Timestamp(6)
  alert_type          String?        @db.VarChar(20)
  domain              String?        @db.VarChar(10)
  metadata            Json?
  alert_history_id    Int?
  lease_expires_at    DateTime?      @db.Timestamp(6)
  heartbeat_at        DateTime?      @db.Timestamp(6)
  provider_message_id String?        @db.VarChar(255)
  idempotency_key     String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  users               users?         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  alert_history       alert_history? @relation(fields: [alert_history_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([alert_history_id], map: "email_queue_alert_history_id_key")
  @@index([status, scheduled_for, lease_expires_at, priority(sort: Desc)], map: "idx_email_queue_claim")
  @@index([priority(sort: Desc), scheduled_for], map: "idx_email_queue_priority")
  @@index([scheduled_for], map: "idx_email_queue_scheduled")
  @@index([status], map: "idx_email_queue_status")
  @@index([user_id], map: "idx_email_queue_user")
}

model esg_event_digest_recipients {
  id                 Int      @id @default(autoincrement())
  email              String   @unique(map: "esg_event_digest_recipients_email_key") @db.VarChar(255)
  is_active          Boolean  @default(true)
  starts_on          DateTime @db.Date
  created_by_user_id Int?
  updated_by_user_id Int?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  created_by         users?   @relation("esg_event_digest_recipients_created_by", fields: [created_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "esg_event_digest_recipients_created_by_fkey")
  updated_by         users?   @relation("esg_event_digest_recipients_updated_by", fields: [updated_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "esg_event_digest_recipients_updated_by_fkey")

  @@index([is_active, starts_on], map: "idx_esg_event_digest_recipients_active")
  @@index([created_by_user_id], map: "idx_esg_event_digest_recipients_created_by")
  @@index([updated_by_user_id], map: "idx_esg_event_digest_recipients_updated_by")
}

model background_jobs {
  id               String    @id @db.Uuid
  job_type         String    @db.VarChar(40)
  user_id          Int
  payload_json     Json      @default("{}")
  input_data       Bytes?
  output_data      Bytes?
  result_json      Json?
  status           String    @default("queued") @db.VarChar(20)
  progress         Int       @default(0)
  progress_json    Json?
  attempts         Int       @default(0)
  max_attempts     Int       @default(3)
  available_at     DateTime  @default(now()) @db.Timestamptz(6)
  lease_owner      String?   @db.VarChar(160)
  lease_expires_at DateTime? @db.Timestamptz(6)
  heartbeat_at     DateTime? @db.Timestamptz(6)
  cancel_requested Boolean   @default(false)
  idempotency_key  String    @unique @db.VarChar(180)
  last_error       String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  completed_at     DateTime? @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, available_at, lease_expires_at, created_at], map: "idx_background_jobs_claim")
  @@index([user_id, status, created_at(sort: Desc)], map: "idx_background_jobs_user_status")
  @@index([job_type, status], map: "idx_background_jobs_type_status")
}

// Per-user, per-domain controls for the private article assistant. These
// tables intentionally live in the ESG database: the ESG user directory is
// the source of identity and the Credit database remains an external content
// and like sink for confirmed Credit feedback.
model article_ai_preferences {
  id              Int       @id @default(autoincrement())
  user_id         Int
  domain          String    @db.VarChar(10)
  enabled         Boolean   @default(false)
  settings_version Int      @default(1)
  status          String    @default("off") @db.VarChar(32)
  history_count   Int       @default(0)
  profile_source  String    @default("insufficient") @db.VarChar(16)
  last_run_at     DateTime? @db.Timestamptz(6)
  last_error      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_ai_preferences_user_id_fkey")

  @@unique([user_id, domain], map: "article_ai_preferences_user_domain_key")
  @@index([user_id, enabled], map: "idx_article_ai_preferences_user_enabled")
  @@index([domain, status], map: "idx_article_ai_preferences_domain_status")
}

model article_ai_profiles {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        Int
  domain         String   @db.VarChar(10)
  profile_version Int
  profile_source String   @db.VarChar(16)
  human_like_count Int
  profile_json   Json
  content_hash   String   @db.VarChar(128)
  model          String?  @db.VarChar(80)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_ai_profiles_user_id_fkey")

  @@unique([user_id, domain, profile_version], map: "article_ai_profiles_user_domain_version_key")
  @@index([user_id, domain, created_at(sort: Desc)], map: "idx_article_ai_profiles_user_domain_created")
}

model article_ai_article_features {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain         String   @db.VarChar(10)
  article_id     Int
  content_hash   String   @db.VarChar(128)
  normalized_text String
  feature_json   Json     @default("{}")
  embedding_json Json?
  model          String?  @db.VarChar(80)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([domain, article_id, content_hash], map: "article_ai_features_domain_article_hash_key")
  @@index([domain, article_id, created_at(sort: Desc)], map: "idx_article_ai_features_domain_article_created")
}

// One provider assessment is shared by every opted-in recipient for a domain
// and UTC day. It intentionally has no user relation: human history is pooled
// across the domain and the resulting profile contains no recipient identity.
model article_ai_domain_assessments {
  id                String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain            String                          @db.VarChar(10)
  assessment_date   DateTime                        @db.Date
  policy_version    Int                             @default(2)
  status            String                          @default("queued") @db.VarChar(24)
  profile_source    String                          @default("insufficient") @db.VarChar(16)
  history_count     Int                             @default(0)
  profile_json      Json?
  content_hash      String?                         @db.VarChar(128)
  model             String?                         @db.VarChar(80)
  input_tokens      Int                             @default(0)
  output_tokens     Int                             @default(0)
  request_count     Int                             @default(0)
  request_limit     Int                             @default(1)
  requests_reserved Int                             @default(0)
  token_limit       Int                             @default(12000)
  tokens_reserved   Int                             @default(0)
  lease_owner       String?                         @db.VarChar(180)
  lease_token       String?                         @db.Uuid
  lease_expires_at  DateTime?                       @db.Timestamptz(6)
  source_start_at   DateTime?                       @db.Timestamptz(6)
  source_cutoff_at  DateTime?                       @db.Timestamptz(6)
  processing_at     DateTime?                       @db.Timestamptz(6)
  email_at          DateTime?                       @db.Timestamptz(6)
  valid_until       DateTime?                       @db.Timestamptz(6)
  manifest_cutoff_at DateTime?                      @db.Timestamptz(6)
  phase             String?                         @db.VarChar(32)
  coverage_json     Json?
  manifest_hash     String?                         @db.VarChar(128)
  error             String?
  created_at        DateTime                        @default(now()) @db.Timestamptz(6)
  started_at        DateTime?                       @db.Timestamptz(6)
  completed_at      DateTime?                       @db.Timestamptz(6)
  updated_at        DateTime                        @default(now()) @updatedAt @db.Timestamptz(6)
  selections        article_ai_domain_selections[]
  weekly_inputs     article_ai_weekly_inputs[]
  weekly_batches    article_ai_weekly_batches[]

  @@unique([domain, assessment_date, policy_version], map: "article_ai_domain_assessments_domain_date_policy_key")
  @@index([domain, status, assessment_date(sort: Desc)], map: "idx_article_ai_domain_assessments_domain_status_date")
  @@index([status, lease_expires_at], map: "idx_article_ai_domain_assessments_lease")
}

model article_ai_weekly_inputs {
  id                    String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id         String                         @db.Uuid
  kind                  String                         @db.VarChar(16)
  domain                String                         @db.VarChar(10)
  article_id            Int
  content_hash          String?                        @db.VarChar(128)
  title                 String?
  summary               String?
  content               String?
  source                String?
  url                   String?
  published_at          DateTime?                      @db.Timestamptz(6)
  observed_at           DateTime                       @default(now()) @db.Timestamptz(6)
